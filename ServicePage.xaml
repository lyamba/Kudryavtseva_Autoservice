<Page x:Class="Kudryavtseva_Autoservice.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Kudryavtseva_Autoservice"
      mc:Ignorable="d"
      IsVisibleChanged="Page_IsVisibleChanged"
      Title="ServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock Text="Введите название для поиска" TextAlignment="Right" Width="300" FontSize="20"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="300" FontSize="15"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Выберите название для поиска" TextAlignment="Right" Width="300" FontSize="20"/>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15" Width="200">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 5 %</TextBlock>
                    <TextBlock>от 5 до 15 %</TextBlock>
                    <TextBlock>от 15 до 30 %</TextBlock>
                    <TextBlock>от 30 до 70 %</TextBlock>
                    <TextBlock>от 70 до 100 %</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
            <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RadioButtonUp_Checked" Name="RadioButtonUp"/>
            <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RadioButtonDown_Checked" Name="RadioButtonDown"/>
        </StackPanel>

        <ListView Name="ServiceListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Width="200" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center" ImageFailed="Image_ImageFailed">
                            <Image.Source>
                                <Binding Path="MainImagePath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Resources/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap">
                            <Run Text="{Binding Title}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20">
                            <Run Text="{Binding Cost, StringFormat={}{0:0} рублей за}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" FontSize="20">
                            <Run Text="{Binding Duration}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="16"
                                   Text="{Binding Discount, StringFormat=*скидка {0:P0} }"
                                   Opacity="{Binding Discount, TargetNullValue=0, FallbackValue=1}"
                                   Visibility="{Binding Discount, TargetNullValue=Collapsed, FallbackValue=Visible}"/>

                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                            <Button Name="EditButton" Content="редактировать" Margin="2" Click="EditButton_Click"/>
                            <Button Name="DeleteButton" Content="удалить" Margin="2" Click="DeleteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Content="Добавить" Name="AddButton" Click="AddButton_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="150" Height="30" Margin="10"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,5" VerticalAlignment="Center">
            <TextBlock Name="TBCount" FontSize="20" Height="20"/>
            <TextBlock Name="TBAllRecords" FontSize="20" Height="20"/>
            <Button Name="LeftDirButton" Content="&lt;" Width="20" Height="20" Click="LeftDirButton_Click"/>
            <ListBox FontSize="20" Name="PageListBox" MouseUp="PageListBox_MouseUp" Margin="5,0" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Name="RightDirButton" Content="&gt;" Width="20" Height="20" Click="RightDirButton_Click"/>
        </StackPanel>

    </Grid>
</Page>