<Window x:Class="Kudryavtseva_Autoservice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kudryavtseva_Autoservice"
        mc:Ignorable="d"
        Title="Кудрявцева" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43*"/>
            <ColumnDefinition Width="757*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Source="Resources/service_logo.png" HorizontalAlignment="Left" Grid.ColumnSpan="2"/>
        <TextBlock Text="Заголовок" FontSize="30" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Margin="286,0,0,0"/>
        <Frame Grid.Row="1" x:Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"></Frame>
        <Button Grid.Row="2" Content="Назад" x:Name="BtnBack" HorizontalAlignment="Left" Click="BtnBack_Click" Grid.Column="1" Margin="577,5,0,5"/>
    </Grid>
</Window>
