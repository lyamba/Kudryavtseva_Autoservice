<Page x:Class="Kudryavtseva_Autoservice.SignUpPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="SignUpPage" FontFamily="Tw Cen MT">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Наименование услуги" FontSize="15" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
        <TextBox Name="TBTitle" Grid.Column="1" Grid.Row="0" Height="30" FontSize="20" Margin="5" VerticalAlignment="Center"
Text="{Binding Title}" IsEnabled="False"/>
        
        <TextBlock Text="Длительность, мин." FontSize="15" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
        <TextBox Name="TBDuration" Grid.Column="1" Grid.Row="1" Height="30" Width="200" FontSize="20" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center"
Text="{Binding Duration}" IsEnabled="False"/>
        
        <TextBlock Text="ФИО клиента" FontSize="15" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Grid.Column="1" Grid.Row="2" Height="30" Width="300" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" Name="ComboClient">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LastName}"/>
                        <TextBlock Text=" "/>
                        <TextBlock Text="{Binding FirstName}"/>
                        <TextBlock Text=" "/>
                        <TextBlock Text="{Binding Patronymic}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        
        <TextBlock Text="Дата" FontSize="15" Grid.Column="0" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Column="1" Grid.Row="3" Height="30" Width="200" FontSize="20" Name="StartDate" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
        
        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Время начала:" FontSize="15" VerticalAlignment="Center"/>
            <TextBox Name="TBStart" Height="30" Width="100" FontSize="20" Margin="5,0,10,0" TextChanged="TBStart_TextChanged"/>
            <TextBlock Text="Время окончания:" FontSize="15" VerticalAlignment="Center" Margin="10,0"/>
            <TextBox Name="TBEnd" Height="30" Width="100" FontSize="20" IsReadOnly="True"/>
        </StackPanel>
        
        <Button Name="SaveButton" Content="Сохранить" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Click="SaveButton_Click" Width="150" Height="40" HorizontalAlignment="Center" FontSize="16" Background="#FFFF9C1A"/>
    </Grid>
</Page>
